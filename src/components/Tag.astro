---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "base" | "lg";
  count?: number;
  variant?: "pill" | "card" | "classic";
  class?: string;
};

const {
  tag,
  tagName,
  size = "base",
  count,
  variant = "pill",
  class: className = "",
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li
  class={`tag-item inline-block ${className}`}
  data-tag-name={tagName.toLowerCase()}
  data-slug={tag}
>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "group inline-flex items-center transition-all duration-200 select-none",
      variant === "pill" && [
        "rounded-lg border border-border/70 bg-muted/25 px-2.5 py-1 text-foreground/90",
        "hover:border-accent hover:bg-accent/10 hover:text-accent hover:-translate-y-0.5 hover:shadow-xs",
        "focus-visible:border-accent focus-visible:ring-1 focus-visible:ring-accent",
        { "text-xs gap-1 py-0.5 px-2": size === "sm" },
        { "text-sm gap-1.5": size === "base" },
        { "text-base gap-2 px-3.5 py-1.5 font-semibold": size === "lg" },
      ],
      variant === "card" && [
        "w-full flex-col items-start rounded-xl border border-border/80 bg-muted/15 p-3.5",
        "hover:border-accent hover:bg-accent/5 hover:-translate-y-1 hover:shadow-sm",
        "focus-visible:border-accent",
      ],
      variant === "classic" && [
        "flex items-center gap-0.5 border-foreground border-b-2 border-dashed",
        "hover:border-accent hover:text-accent hover:-mt-0.5",
        { "text-sm": size === "sm" },
        { "text-lg": size === "lg" },
      ],
    ]}
  >
    {
      variant !== "card" ? (
        <>
          <IconHash
            class:list={[
              "opacity-50 transition-colors group-hover:text-accent group-hover:opacity-100",
              { "size-3.5": size === "sm" },
              { "size-4": size === "base" },
              { "size-4.5": size === "lg" },
            ]}
          />
          <span class="font-medium tracking-tight">{tagName}</span>
          {typeof count === "number" && (
            <span
              class:list={[
                "ml-1 inline-flex items-center justify-center rounded-md bg-muted/80 px-1.5 py-0.2 text-muted-foreground font-mono transition-colors",
                "group-hover:bg-accent/20 group-hover:text-accent",
                { "text-[10px] min-w-4 h-4": size === "sm" },
                { "text-xs min-w-4.5 h-4.5": size === "base" || size === "lg" },
              ]}
            >
              {count}
            </span>
          )}
        </>
      ) : (
        <div class="flex w-full items-center justify-between">
          <div class="flex items-center gap-1.5 font-semibold text-accent">
            <IconHash class="size-4 opacity-80" />
            <span class="text-base tracking-tight">{tagName}</span>
          </div>
          {typeof count === "number" && (
            <span class="rounded-full bg-accent/15 px-2 py-0.5 font-mono text-xs font-bold text-accent">
              {count} 篇
            </span>
          )}
        </div>
      )
    }
  </a>
</li>
