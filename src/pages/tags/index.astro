---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getUniqueTags(posts);

// 提取热门高频技术标签 (文章数 >= 3)
const topTags = [...tags]
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag))
  .filter(t => t.count >= 3);

// 按热度降序的全部标签
const tagsSortedByCount = [...tags].sort(
  (a, b) => b.count - a.count || a.tag.localeCompare(b.tag)
);

// 汉字拼音首字母映射辅助函数
function getTagInitial(tagName: string): string {
  const first = tagName.trim()[0];
  if (!first) return "#";
  if (/[a-zA-Z]/.test(first)) return first.toUpperCase();

  const zhRange: [string, string, string][] = [
    ["啊", "芭", "A"],
    ["芭", "擦", "B"],
    ["擦", "搭", "C"],
    ["搭", "蛾", "D"],
    ["蛾", "发", "E"],
    ["发", "噶", "F"],
    ["噶", "哈", "G"],
    ["哈", "击", "H"],
    ["击", "喀", "J"],
    ["喀", "垃", "K"],
    ["垃", "妈", "L"],
    ["妈", "拿", "M"],
    ["拿", "噢", "N"],
    ["噢", "啪", "O"],
    ["啪", "期", "P"],
    ["期", "然", "Q"],
    ["然", "撒", "R"],
    ["撒", "塌", "S"],
    ["塌", "挖", "T"],
    ["挖", "昔", "W"],
    ["昔", "压", "X"],
    ["压", "匝", "Y"],
    ["匝", "座", "Z"],
  ];

  for (const [start, end, letter] of zhRange) {
    if (
      first.localeCompare(start, "zh-Hans-CN") >= 0 &&
      first.localeCompare(end, "zh-Hans-CN") < 0
    ) {
      return letter;
    }
  }
  return "#";
}

// 按首字母对标签进行聚合分组
const alphabetGroups: Record<string, typeof tags> = {};
for (const item of tags) {
  const letter = getTagInitial(item.tagName);
  if (!alphabetGroups[letter]) {
    alphabetGroups[letter] = [];
  }
  alphabetGroups[letter].push(item);
}

// 保证字母表顺序
const availableLetters = Object.keys(alphabetGroups).sort((a, b) => {
  if (a === "#") return 1;
  if (b === "#") return -1;
  return a.localeCompare(b);
});

for (const letter of availableLetters) {
  alphabetGroups[letter].sort((a, b) =>
    a.tagName.localeCompare(b.tagName, "zh-Hans-CN")
  );
}

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tagsTitle} pageDesc="博客文章所使用的全部技术标签索引与知识图谱。">
    <!-- 1. 统计数据概览条 -->
    <div
      class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4"
    >
      <div
        class="border-border/70 bg-muted/20 flex flex-col justify-center rounded-xl border p-4 transition-colors hover:border-accent/40"
      >
        <span class="text-muted-foreground text-xs font-medium">技术标签总计</span>
        <div class="mt-1 flex items-baseline gap-1.5">
          <span class="text-foreground text-2xl font-bold font-mono">{tags.length}</span>
          <span class="text-muted-foreground text-xs">个</span>
        </div>
      </div>
      <div
        class="border-border/70 bg-muted/20 flex flex-col justify-center rounded-xl border p-4 transition-colors hover:border-accent/40"
      >
        <span class="text-muted-foreground text-xs font-medium">覆盖技术文章</span>
        <div class="mt-1 flex items-baseline gap-1.5">
          <span class="text-foreground text-2xl font-bold font-mono">{posts.length}</span>
          <span class="text-muted-foreground text-xs">篇</span>
        </div>
      </div>
      <div
        class="border-border/70 bg-muted/20 col-span-2 sm:col-span-1 flex flex-col justify-center rounded-xl border p-4 transition-colors hover:border-accent/40"
      >
        <span class="text-muted-foreground text-xs font-medium">重点技术领域 (≥3篇)</span>
        <div class="mt-1 flex items-baseline gap-1.5">
          <span class="text-accent text-2xl font-bold font-mono">{topTags.length}</span>
          <span class="text-muted-foreground text-xs">个核心方向</span>
        </div>
      </div>
    </div>

    <!-- 2. 即时搜索与过滤输入框 -->
    <div class="mb-10">
      <div class="relative w-full">
        <div
          class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-muted-foreground"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-4.5 opacity-70"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
        </div>
        <input
          type="text"
          id="tag-search-input"
          placeholder="输入关键词即时筛选标签 (如: C++, Linux, 网络, 架构...)"
          class="w-full rounded-xl border border-border/80 bg-background/80 py-2.5 pr-10 pl-10 text-sm text-foreground placeholder:text-muted-foreground/70 transition-all focus:border-accent focus:bg-background focus:outline-none focus:ring-2 focus:ring-accent/20"
          autocomplete="off"
        />
        <button
          type="button"
          id="tag-search-clear"
          class="absolute inset-y-0 right-0 hidden items-center pr-3 text-muted-foreground hover:text-foreground cursor-pointer"
          aria-label="清除筛选"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- 3. 🔥 热门核心技术栈精选推荐 -->
    {
      topTags.length > 0 && (
        <section class="mb-12" id="top-tags-section">
          <div class="mb-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-base font-bold text-foreground">🔥 热门核心技术栈</span>
              <span class="text-xs text-muted-foreground font-mono">
                (已沉淀 ≥ 3 篇文章)
              </span>
            </div>
            <span class="text-xs text-muted-foreground">精选专长</span>
          </div>

          <ul class="flex flex-wrap gap-2.5">
            {topTags.map(({ tag, tagName, count }) => (
              <Tag {tag} {tagName} {count} size="lg" />
            ))}
          </ul>
        </section>
      )
    }

    <!-- 4. 全部标签与视图控制器 -->
    <section class="mb-12">
      <div
        class="border-border/60 mb-6 flex flex-wrap items-center justify-between gap-4 border-b pb-4"
      >
        <div class="flex items-center gap-2">
          <h2 class="text-base font-bold text-foreground">
            技术标签索引库
          </h2>
          <span
            id="visible-count-badge"
            data-total={tags.length}
            class="rounded-full bg-muted/80 px-2 py-0.5 text-xs text-muted-foreground font-mono"
          >
            共 {tags.length} 个
          </span>
        </div>

        <!-- 视图切换模式：按热度 vs 按字母 -->
        <div
          class="border-border/80 bg-muted/30 flex items-center rounded-lg border p-0.5 text-xs font-medium"
        >
          <button
            type="button"
            id="btn-view-count"
            class="bg-background text-foreground flex items-center gap-1 rounded-md px-3 py-1 shadow-xs transition-all cursor-pointer"
          >
            <span>🔥 按文章数量</span>
          </button>
          <button
            type="button"
            id="btn-view-alpha"
            class="text-muted-foreground hover:text-foreground flex items-center gap-1 rounded-md px-3 py-1 transition-all cursor-pointer"
          >
            <span>🔤 按首字母分组</span>
          </button>
        </div>
      </div>

      <!-- 视图 A：按热度排列的平铺胶囊列表 -->
      <div id="view-count-container" class="transition-opacity duration-200">
        <ul class="flex flex-wrap gap-2.5" id="tag-cloud-list">
          {tagsSortedByCount.map(({ tag, tagName, count }) => (
            <Tag {tag} {tagName} {count} size="base" />
          ))}
        </ul>
      </div>

      <!-- 视图 B：按首字母 A-Z 分组的规整列表 -->
      <div id="view-alpha-container" class="hidden transition-opacity duration-200">
        <!-- 字母快速导航锚点栏 -->
        <nav
          aria-label="字母快速索引"
          class="border-border/60 bg-muted/15 mb-8 flex flex-wrap gap-1.5 rounded-xl border p-2.5 text-xs"
        >
          {availableLetters.map(letter => (
            <a
              href={`#letter-group-${letter}`}
              class="hover:border-accent hover:bg-accent/15 hover:text-accent flex size-7 items-center justify-center rounded-md border border-transparent font-bold transition-all"
            >
              {letter}
            </a>
          ))}
        </nav>

        <!-- 字母各分区列表 -->
        <div class="space-y-8">
          {availableLetters.map(letter => (
            <div
              id={`letter-group-${letter}`}
              class="letter-group scroll-mt-20"
            >
              <div class="mb-3 flex items-center gap-2">
                <span class="text-accent text-lg font-bold font-mono">
                  {letter}
                </span>
                <div class="h-px flex-1 bg-border/60" />
                <span class="text-muted-foreground text-xs font-mono">
                  {alphabetGroups[letter].length} 个
                </span>
              </div>
              <ul class="flex flex-wrap gap-2">
                {alphabetGroups[letter].map(({ tag, tagName, count }) => (
                  <Tag {tag} {tagName} {count} size="sm" />
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- 搜索无结果提示 (Empty State) -->
      <div
        id="tag-empty-state"
        class="border-border/70 text-muted-foreground my-8 hidden rounded-xl border border-dashed p-8 text-center"
      >
        <p class="text-base font-medium">没有找到匹配的技术标签</p>
        <p class="mt-1.5 text-xs opacity-80" id="tag-empty-hint">
          请尝试搜索其他关键字，或点击输入框右侧清空重新筛选。
        </p>
      </div>
    </section>
  </Main>

  <Footer />
</Layout>

<script>
  function setupTagPage() {
    const searchInput = document.getElementById(
      "tag-search-input"
    ) as HTMLInputElement | null;
    const clearBtn = document.getElementById(
      "tag-search-clear"
    ) as HTMLButtonElement | null;
    const emptyState = document.getElementById("tag-empty-state");
    const emptyHint = document.getElementById("tag-empty-hint");
    const countBadge = document.getElementById("visible-count-badge");
    const topTagsSection = document.getElementById("top-tags-section");

    const btnViewCount = document.getElementById("btn-view-count");
    const btnViewAlpha = document.getElementById("btn-view-alpha");
    const viewCountContainer = document.getElementById("view-count-container");
    const viewAlphaContainer = document.getElementById("view-alpha-container");

    if (!searchInput) return;

    // 1. 视图模式切换 (按文章数量 vs 按首字母)
    let currentMode: "count" | "alpha" = "count";

    function setViewMode(mode: "count" | "alpha") {
      currentMode = mode;
      if (mode === "count") {
        viewCountContainer?.classList.remove("hidden");
        viewAlphaContainer?.classList.add("hidden");

        btnViewCount?.classList.add("bg-background", "text-foreground", "shadow-xs");
        btnViewCount?.classList.remove("text-muted-foreground");
        btnViewAlpha?.classList.remove("bg-background", "text-foreground", "shadow-xs");
        btnViewAlpha?.classList.add("text-muted-foreground");
      } else {
        viewCountContainer?.classList.add("hidden");
        viewAlphaContainer?.classList.remove("hidden");

        btnViewAlpha?.classList.add("bg-background", "text-foreground", "shadow-xs");
        btnViewAlpha?.classList.remove("text-muted-foreground");
        btnViewCount?.classList.remove("bg-background", "text-foreground", "shadow-xs");
        btnViewCount?.classList.add("text-muted-foreground");
      }
      applyFilter();
    }

    btnViewCount?.addEventListener("click", () => setViewMode("count"));
    btnViewAlpha?.addEventListener("click", () => setViewMode("alpha"));

    // 2. 搜索过滤逻辑
    function applyFilter() {
      const query = (searchInput?.value || "").trim().toLowerCase();

      // 控制清除按钮显示与隐藏
      if (clearBtn) {
        if (query.length > 0) {
          clearBtn.classList.remove("hidden");
          clearBtn.classList.add("flex");
        } else {
          clearBtn.classList.add("hidden");
          clearBtn.classList.remove("flex");
        }
      }

      // 如果有输入，暂时隐藏热门推荐模块，专注看匹配结果
      if (topTagsSection) {
        if (query.length > 0) {
          topTagsSection.classList.add("hidden");
        } else {
          topTagsSection.classList.remove("hidden");
        }
      }

      // 统计所有被筛选出来的 tag-item
      const allTagItems = document.querySelectorAll(
        "#view-count-container .tag-item, #view-alpha-container .tag-item"
      );

      let visibleSet = new Set<string>();

      allTagItems.forEach(el => {
        const item = el as HTMLElement;
        const tagName = (item.dataset.tagName || "").toLowerCase();
        const slug = (item.dataset.slug || "").toLowerCase();

        const matches = !query || tagName.includes(query) || slug.includes(query);

        if (matches) {
          item.classList.remove("hidden");
          if (slug) visibleSet.add(slug);
        } else {
          item.classList.add("hidden");
        }
      });

      // 如果在字母分组视图，检查每个字母区块是否还有可见标签
      if (currentMode === "alpha") {
        const letterGroups = document.querySelectorAll(".letter-group");
        letterGroups.forEach(group => {
          const groupEl = group as HTMLElement;
          const visibleInGroup = groupEl.querySelectorAll(".tag-item:not(.hidden)");
          if (visibleInGroup.length === 0) {
            groupEl.classList.add("hidden");
          } else {
            groupEl.classList.remove("hidden");
          }
        });
      }

      // 更新数量提示
      const visibleCount = visibleSet.size;
      if (countBadge) {
        const total = countBadge.dataset.total || "123";
        countBadge.textContent = query
          ? `匹配 ${visibleCount} 个`
          : `共 ${total} 个`;
      }

      // 空状态提示
      if (emptyState) {
        if (visibleCount === 0 && query) {
          emptyState.classList.remove("hidden");
          if (emptyHint) {
            emptyHint.textContent = `没有找到包含 "${query}" 的技术标签，请检查拼写或尝试其他关键词。`;
          }
        } else {
          emptyState.classList.add("hidden");
        }
      }
    }

    searchInput.addEventListener("input", applyFilter);

    clearBtn?.addEventListener("click", () => {
      searchInput.value = "";
      searchInput.focus();
      applyFilter();
    });
  }

  // 支持 Astro View Transitions 和普通页面加载
  document.addEventListener("astro:page-load", setupTagPage);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupTagPage);
  } else {
    setupTagPage();
  }
</script>
